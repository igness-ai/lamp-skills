<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <constants>
        <name>CaseOwnerId</name>
        <dataType>String</dataType>
        <value><stringValue>{{OWNER_ID}}</stringValue></value>
    </constants>
    <decisions>
        <name>HasOpenCase</name>
        <label>対応中ケースがあるか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateCase</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>なし</defaultConnectorLabel>
        <rules>
            <name>OpenCaseExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrentCase__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>ResetSwitchOnly</targetReference>
            </connector>
            <label>あり</label>
        </rules>
    </decisions>
    <description>友だちの「ケース起動」がオンになったらケースを作成し、「対応中ケース」にセットしてスイッチを戻す。対応中ケースがある場合は作成しない。（lamp-case-support）</description>
    <label>LAMP ケース起動</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateCase</name>
        <label>ケースを作成</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LinkCaseAndResetSwitch</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value><stringValue>{{SUBJECT}}</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>{{STATUS_NEW}}</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value><stringValue>{{ORIGIN}}</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SocialFriend__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value><elementReference>$Record.igns__Contact__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>CaseOwnerId</elementReference></value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>LinkCaseAndResetSwitch</name>
        <label>対応中ケースをセットしスイッチを戻す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CurrentCase__c</field>
            <value><elementReference>CreateCase</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>IsCreateCase__c</field>
            <value><booleanValue>false</booleanValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>ResetSwitchOnly</name>
        <label>スイッチだけ戻す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>IsCreateCase__c</field>
            <value><booleanValue>false</booleanValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>HasOpenCase</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsCreateCase__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <object>igns__SocialFriend__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
