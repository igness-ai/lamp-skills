<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SendSlackMessage</name>
        <label>Slackへ通知</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>slackPostMessage</actionName>
        <actionType>slackPostMessage</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>slackAppIdForToken</name>
            <value><stringValue>{{SLACK_APP_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackWorkspaceIdForToken</name>
            <value><stringValue>{{SLACK_WORKSPACE_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackConversationId</name>
            <value><stringValue>{{SLACK_CHANNEL_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackMessage</name>
            <value><elementReference>SlackMessage</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <nameSegment>slackPostMessage</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>CheckTarget</name>
        <label>通知対象か</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>対象外</defaultConnectorLabel>
        <rules>
            <name>Target</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsTarget</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>SendSlackMessage</targetReference>
            </connector>
            <label>対象</label>
        </rules>
    </decisions>
    <description>友だちレコードが作成されたら（コミット後に非同期で）Slack に通知する。（lamp-slack-notify）</description>
    <formulas>
        <description>公式アカウント（空なら全て）で絞り込む。</description>
        <name>IsTarget</name>
        <dataType>Boolean</dataType>
        <expression>&quot;{{LAMP_ID}}&quot; = &quot;&quot; || {!$Record.igns__LampId__c} = &quot;{{LAMP_ID}}&quot;</expression>
    </formulas>
    <formulas>
        <name>FriendLink</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;&quot; &amp; LEFT({!$Api.Partner_Server_URL_600}, FIND(&quot;/services/&quot;, {!$Api.Partner_Server_URL_600})) &amp; {!$Record.Id} &amp; &quot;|&quot; &amp; {!$Record.Name} &amp; &quot;&gt;&quot;</expression>
    </formulas>
    <interviewLabel>{{FLOW_LABEL}} {!$Flow.CurrentDateTime}</interviewLabel>
    <label>{{FLOW_LABEL}}</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>igns__SocialFriend__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>CheckTarget</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>SlackMessage</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{{SLACK_MESSAGE}}</text>
    </textTemplates>
</Flow>
