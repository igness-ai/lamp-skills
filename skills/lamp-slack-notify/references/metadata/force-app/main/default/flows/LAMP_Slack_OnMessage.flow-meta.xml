<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SendSlackMessage</name>
        <label>Slackへ通知</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>slackPostMessage</actionName>
        <actionType>slackPostMessage</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>slackAppIdForToken</name>
            <value><stringValue>{{SLACK_APP_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackWorkspaceIdForToken</name>
            <value><stringValue>{{SLACK_WORKSPACE_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackConversationId</name>
            <value><stringValue>{{SLACK_CHANNEL_ID}}</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>slackMessage</name>
            <value><elementReference>SlackMessage</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value><elementReference>GetSocialFriend.Id</elementReference></value>
        </inputParameters>
        <nameSegment>slackPostMessage</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>CheckTarget</name>
        <label>通知対象か</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>対象外</defaultConnectorLabel>
        <rules>
            <name>Target</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsTarget</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>GetSocialFriend</targetReference>
            </connector>
            <label>対象</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsFriendFound</name>
        <label>友だちが特定できたか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>特定できず</defaultConnectorLabel>
        <rules>
            <name>FriendFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetSocialFriend</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>SendSlackMessage</targetReference>
            </connector>
            <label>特定できた</label>
        </rules>
    </decisions>
    <description>LAMP のプラットフォームイベントで起動し、友だちから受信したメッセージを Slack に通知する。（lamp-slack-notify）</description>
    <formulas>
        <description>通知対象か。受信（incoming）で、イベント種別（カンマ区切り）に含まれ、公式アカウント（空なら全て）が一致するもの。</description>
        <name>IsTarget</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.igns__Direction__c} = &quot;incoming&quot;
&amp;&amp; ISBLANK({!$Record.igns__GroupId__c})
&amp;&amp; CONTAINS(&quot;,{{EVENT_TYPES}},&quot;, &quot;,&quot; &amp; {!$Record.igns__EventType__c} &amp; &quot;,&quot;)
&amp;&amp; (&quot;{{LAMP_ID}}&quot; = &quot;&quot; || {!$Record.igns__LampId__c} = &quot;{{LAMP_ID}}&quot;)</expression>
    </formulas>
    <formulas>
        <description>友だちレコードへの Slack リンク（組織のURLから組み立てる）。</description>
        <name>FriendLink</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;&quot; &amp; LEFT({!$Api.Partner_Server_URL_600}, FIND(&quot;/services/&quot;, {!$Api.Partner_Server_URL_600})) &amp; {!GetSocialFriend.Id} &amp; &quot;|&quot; &amp; {!GetSocialFriend.Name} &amp; &quot;&gt;&quot;</expression>
    </formulas>
    <interviewLabel>{{FLOW_LABEL}} {!$Flow.CurrentDateTime}</interviewLabel>
    <label>{{FLOW_LABEL}}</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>LAMP ID と LINE ユーザーIDの組み合わせで友だちを特定する。</description>
        <name>GetSocialFriend</name>
        <label>友だちの取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsFriendFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>igns__LampId__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.igns__LampId__c</elementReference></value>
        </filters>
        <filters>
            <field>igns__UserId__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.igns__UserId__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>igns__SocialFriend__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckTarget</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>igns__LampNotification__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>SlackMessage</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{{SLACK_MESSAGE}}</text>
    </textTemplates>
</Flow>
